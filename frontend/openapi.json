  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "current_balance": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "color_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Key"
          },
          "opened_on": {
            "type": "string",
            "format": "date",
            "title": "Opened On"
          },
          "archived_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "created_on": {
            "type": "string",
            "format": "date",
            "title": "Created On"
          },
          "updated_on": {
            "type": "string",
            "format": "date",
            "title": "Updated On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "current_balance",
          "opened_on",
          "created_on",
          "updated_on"
        ],
        "title": "AccountResponse"
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "cash",
          "debit_card",
          "credit_card",
          "bank_account",
          "wallet",
          "system"
        ],
        "title": "AccountType"
      },
      "ActiveTaskResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "view": {
            "$ref": "#/components/schemas/TaskViewResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "view"
        ],
        "title": "ActiveTaskResponse"
      },
      "ControlAction": {
        "type": "string",
        "enum": [
          "help",
          "cancel",
          "restart"
        ],
        "title": "ControlAction"
      },
      "ControlActionTurnInput": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "control_action",
            "title": "Kind"
          },
          "action": {
            "$ref": "#/components/schemas/ControlAction"
          },
          "expected_task_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Task Id"
          },
          "expected_conversation_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Conversation Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "action"
        ],
        "title": "ControlActionTurnInput"
      },
      "ConversationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "active_task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveTaskResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnOutcomeResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "active_task",
          "last_outcome"
        ],
        "title": "ConversationResponse"
      },
      "CreateAccountRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType",
            "default": "debit_card"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "title": "Currency",
            "default": "ARS"
          },
          "opening_balance_minor": {
            "type": "integer",
            "title": "Opening Balance Minor",
            "default": 0
          },
          "opened_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opened On"
          },
          "color_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateAccountRequest"
      },
      "CreateIncomeCategoryRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateIncomeCategoryRequest"
      },
      "CreateSpendingCategoryRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateSpendingCategoryRequest"
      },
      "CreateTransactionPostingRequest": {
        "properties": {
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "category_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Id"
          },
          "amount_minor": {
            "type": "integer",
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "title": "Currency"
          },
          "memo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_minor",
          "currency"
        ],
        "title": "CreateTransactionPostingRequest"
      },
      "CreateTransactionRequest": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/CreateTransactionPostingRequest"
            },
            "type": "array",
            "minItems": 1,
            "title": "Postings"
          },
          "occurred_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
